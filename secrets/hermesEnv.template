# Template for secrets/hermesEnv.age (docker --env-file format: KEY=value, no quotes).
# Filled in and encrypted by scripts/setup-hermes.sh. Edit later on dabass with:
#   cd secrets && agenix -e hermesEnv.age -i /persist/nixos-keys/id_ed25519
#
# Leave unused platform values EMPTY: a non-empty placeholder enables the
# platform and makes it fail.

# Anthropic Console API key (sk-ant-api03-...)
ANTHROPIC_API_KEY=@ANTHROPIC_API_KEY@

# Dashboard login (http://hermes.dabass)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=dialtone
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=@DASHBOARD_PASSWORD@
HERMES_DASHBOARD_BASIC_AUTH_SECRET=@DASHBOARD_SECRET@

# Bearer key for the OpenAI-compatible API (http://hermes-api.dabass)
API_SERVER_KEY=@API_SERVER_KEY@

# Telegram: token from @BotFather, your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=@TELEGRAM_BOT_TOKEN@
TELEGRAM_ALLOWED_USERS=@TELEGRAM_ALLOWED_USERS@

# Discord: bot token, your user id, and the private channel id
DISCORD_BOT_TOKEN=@DISCORD_BOT_TOKEN@
DISCORD_ALLOWED_USERS=@DISCORD_ALLOWED_USERS@
DISCORD_ALLOWED_CHANNELS=@DISCORD_CHANNEL@
DISCORD_HOME_CHANNEL=@DISCORD_CHANNEL@

# Email: dedicated mailbox (app password), your own address(es) as allowlist
EMAIL_ADDRESS=@EMAIL_ADDRESS@
EMAIL_PASSWORD=@EMAIL_PASSWORD@
EMAIL_IMAP_HOST=@EMAIL_IMAP_HOST@
EMAIL_SMTP_HOST=@EMAIL_SMTP_HOST@
EMAIL_ALLOWED_USERS=@EMAIL_ALLOWED_USERS@

# Home Assistant: long-lived token of the non-admin `hermes` HA user
HASS_TOKEN=@HASS_TOKEN@

# WhatsApp: your own number(s), digits with country code. Enabled by pairing
# (`docker exec -it hermes hermes whatsapp`), not here.
WHATSAPP_ALLOWED_USERS=@WHATSAPP_ALLOWED_USERS@
